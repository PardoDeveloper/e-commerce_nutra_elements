# Copia este archivo como .env y completa los valores. .env NO se versiona.
# Flow (sandbox en desarrollo: https://sandbox.flow.cl/api · producción: https://www.flow.cl/api)
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=
FLOW_SECRET_KEY=

# === Next.js (contrato functions.md 7.2) ===
# Secreto compartido con Functions para POST /api/revalidate (secreto; en prod va en Secret Manager)
REVALIDATE_SECRET=
# Configuración web de Firebase (pública, distinta por ambiente)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# "true" solo en local: conecta a los emuladores
NEXT_PUBLIC_USE_EMULATORS=
# App Check: clave del sitio (reCAPTCHA Enterprise); token de depuración solo en .env.local
NEXT_PUBLIC_FLOW_ENV=
NEXT_PUBLIC_APPCHECK_SITE_KEY=
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=
# Origen canónico del sitio (sin barra final), p. ej. http://localhost:3000
SITE_URL=
# Interruptor de indexación: solo "true" en producción lanzada; cualquier otro valor = noindex
SITE_INDEXABLE=

# Fuente de datos de la tienda pública (servidor): "demo" (por defecto, mock local) o "firebase" (Firestore, D-031)
DATA_SOURCE=
