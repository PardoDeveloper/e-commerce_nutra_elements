# Plantilla: solo nombres, sin valores (contrato functions.md, sección 7.1).
# Copia a functions/.env (o functions/.env.<alias>) y completa. Esos archivos NO se versionan.

# --- Secretos (en la nube van en Secret Manager; en local, en functions/.secret.local o aquí) ---
FLOW_API_KEY=
FLOW_SECRET_KEY=
REVALIDATE_SECRET=

# --- Parámetros (no secretos) ---
APP_ENV=
SITE_URL=
# Correos que pueden autoasignarse admin con claimAdmin (D-031), separados por comas. Vacío = nadie.
ADMIN_EMAILS=
FLOW_API_BASE=
FLOW_CONFIRMATION_URL=
