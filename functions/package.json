{
  "name": "nutra-elements-functions",
  "private": true,
  "description": "Cloud Functions de Nutra Elements (2ª generación, us-east4)",
  "main": "lib/index.js",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "test": "vitest run --config vitest.config.mts --project unit",
    "test:rules": "vitest run --config vitest.config.mts --project rules",
    "typecheck:rules": "tsc -p tsconfig.test.json --noEmit",
    "test:emulator": "echo \"Requiere emuladores; sin ejecutar por D-026\" && exit 1"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.3.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "firebase": "^13.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
